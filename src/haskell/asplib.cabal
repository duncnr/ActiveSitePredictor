cabal-version:       3.8
name:                hslib
version:             0.1.0.0
build-type:          Simple

foreign-library asplib
	type:                native-shared
	-- options:             standalone
	hs-source-dirs:      .

	-- required definitions for windows
	if os(Windows)
		mod-def-file: asplib-def.def
	if os(Windows)
		options: standalone

	if os(Linux)
		ghc-options:
		    -flink-rts
          -fPIC
          -dynamic

	other-modules:
	    ASPLib
	    Data.Retrieval

	build-depends:
	    base,
	    req,
	    aeson,
	    text,
	    bytestring,
       zlib

	default-language:		Haskell2010
